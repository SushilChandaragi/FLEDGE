PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (no database name needed; MONGODB_DB is used)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=cnest_fledge

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

# Shared secret used by the Google Apps Script to call POST /api/registration/sync
REGISTRATION_SYNC_SECRET=change-me-too

# Event bootstrap (used by `npm run seed:event`)
EVENT_ID=FLEDGE26
REGISTRATION_FORM_URL=https://forms.gle/REPLACE_ME

# Comma separated list of allowed origins; leave empty to allow all (mobile app is not a browser)
CORS_ORIGINS=
